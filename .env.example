# Copy this file to .env and fill in your own values.
# Never commit .env to version control.

# Secret key used to sign security events with HMAC-SHA256.
# Generate a strong random value, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET_KEY=replace_me_with_a_strong_random_secret

# Demo credentials (used by the /login route for simulation)
DEMO_USERNAME=admin
DEMO_PASSWORD=secret123

# Flask settings
FLASK_ENV=development
FLASK_DEBUG=1

# Grafana login password used by Docker Compose
GRAFANA_ADMIN_PASSWORD=change-this-before-use
